    // [VSCode 输出中文乱码 - Isakura 红 - 博客园](https://www.cnblogs.com/Isakura-red/p/18692383 "")
    // 解决 cmake 插件执行 `--build` 命令时输出中文乱码的问题
    "cmake.outputLogEncoding": "utf-8",
    "terminal.integrated.encoding": "utf8",
    "cmake.environment": {
        "LANG": "en_US.UTF-8"
    },
    // "cmake.loggingLevel": "debug",
    "cmake.terminal.external": true,
    // clang 自动填充设置
    //   需要启用 `-DCMAKE_EXPORT_COMPILE_COMMANDS=ON` 命令
    //   添加 `compile_commands.json` 文件生成目录
    "clangd.arguments": [
        // 传入 clangd 代码提示所需的文件位置
        //   首次配置时可能需要手动执行 `>clangd: Restart language server` 命令
        "--background-index", // 后台分析并保存索引文件
        "--clang-tidy", // 静态检查
        "--compile-commands-dir=out/build/Debug",  // 编译数据库(compile_commands.json 文件)的目录位置
        "--completion-parse=auto", // 当 clangd 准备就绪时，用它来分析建议
        "--completion-style=bundled",
        "--enable-config",
        "--fallback-style=Google",  // 格式化风格
        "--function-arg-placeholders=true", // 补全函数时，将会给参数提供占位符，键入后按 Tab 可以切换到下一占位符，乃至函数末
        "--header-insertion-decorators=false",  // 减少代码预热（Preamble）保存的内存
        "--header-insertion=never", // 禁用自动插入头文件
        "--pretty",  // 输出的 JSON 文件更美观
        "--ranking-model=decision_forest",  // 建议的排序方案：hueristics (启发式), decision_forest (决策树)
        "-j=4",  // 同时开启的任务数量，降低线程数有助于减少内容占用
        // "--all-scopes-completion",  // 自动补全头文件
        // "--background-index-priority=low",  // 降低后台索引的优先级，避免其疯狂抢占资源
        // "--background-index=false",  // 禁用全项目索引（如果项目极大，建议开启。开启后只索引打开的文件，大幅省内存）
        // "--header-insertion=iwyu", // 插入建议时自动引入头文件 iwyu
        // "--limit-results=100",  // 限制代码补全返回的结果数量，防止单次内存暴涨
        // "--log=verbose",
        // "--malloc-trim",  // 强制在每个翻译单元解析后清理内存（非常有用）
        // "--pch-storage=memory",  // pch 优化的位置
    ],
