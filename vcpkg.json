{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "description": "Simple chat based on the Qt GRPC client API.",
    "dependencies": [
        "fmt",
        "protobuf",
        "grpc",
        "sqlcipher",
        "nlohmann-json",
        "yaml-cpp",
        "spdlog",
        "boost-uuid"
    ],
    "features": {
        "vcpkg-qt": {
            "description": "Use Qt libraries from vcpkg",
            "dependencies": [
                {
                    "name": "qtgrpc",
                    "version>=": "6.8.3"
                },
                {
                    "name": "qtdeclarative",
                    "version>=": "6.8.3"
                },
                {
                    "name": "fmt",
                    "version>=": "11.0.2"
                },
                {
                    "name": "protobuf",
                    "version>=": "5.29.3"
                },
                {
                    "name": "grpc",
                    "version>=": "1.71.0"
                },
                {
                    "name": "sqlcipher",
                    "version>=": "4.6.1"
                },
                {
                    "name": "nlohmann-json",
                    "version>=": "3.11.3"
                },
                {
                    "name": "yaml-cpp",
                    "version>=": "0.8.0"
                },
                {
                    "name": "spdlog",
                    "version>=": "1.15.2"
                },
                {
                    "name": "boost-uuid",
                    "version>=": "1.87.0"
                }
            ]
        }
    }
}
